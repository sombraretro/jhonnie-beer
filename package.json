{
  "name": "jhonnie-beer-pdv",
  "version": "3.2.4",
  "private": true,
  "description": "Jhonnie Beer — Sistema de Ponto de Venda",
  "author": "Rudnei Souza",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "npm run build && electron . --production",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dir": "npm run build && electron-builder --win dir",
    "install:clean": "npm install",
    "test:integration": "node --no-warnings --test tests/uni-3.2.test.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "node-forge": "^1.3.6",
    "xml-crypto": "^6.1.2",
    "@xmldom/xmldom": "^0.8.11",
    "qrcode": "^1.5.4",
    "nodemailer": "^7.0.6",
    "pdfkit": "0.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.3",
    "wait-on": "^8.0.1",
    "node-gyp": "12.1.0"
  },
  "build": {
    "appId": "br.unisoftwares.jhonniebeer",
    "productName": "Jhonnie Beer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "nfce.js",
      "operator-auth.js",
      "mobile-server.js",
      "uni-management.js",
      "node_modules/**/*",
      "package.json",
      "icon.ico",
      "Logo-Jhonnie-Beer.jpeg",
      "uni-softwares-logo-sobre.png",
      "cash-register.mp3"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Jhonnie-Beer-Setup-${version}-${arch}.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jhonnie Beer"
    },
    "artifactName": "Uni-PDV-Licenciado-Setup-${version}-${arch}.${ext}"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  },
  "productName": "Jhonnie Beer",
  "artifactName": "Jhonnie-Beer-Setup-${version}-${arch}.${ext}"
}
